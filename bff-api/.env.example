# --- AI inference service (ai-service/inference-api) ---
AI_SERVICE_URL=http://localhost:8000
# 60 s covers a free-tier service waking from sleep (30-50 s cold start).
AI_SERVICE_TIMEOUT_MS=60000

# --- Strapi CMS (cms) ---
STRAPI_URL=http://localhost:1337
# Public origin the game client loads media from. Defaults to STRAPI_URL; set it
# when the BFF reaches Strapi on an internal address (e.g. http://cms:1337 in Docker).
STRAPI_MEDIA_BASE_URL=http://localhost:1337
STRAPI_TIMEOUT_MS=60000

# Must be identical to BFF_SECRET_TOKEN in cms/.env and in the AI service. Sent
# verbatim as the Authorization header to Strapi and as the X-BFF-Token header to
# the AI service (POST /predict). Required when NODE_ENV=production.
BFF_SECRET_TOKEN=tobemodified

# --- HTTP server ---
# Render injects PORT; 3000 locally. The server always binds to 0.0.0.0.
PORT=3000
# The deployed game client origin (Vercel), e.g. https://unfair-life.vercel.app.
# Required in production. Outside production the local Vite origins
# (localhost / 127.0.0.1 on ports 5173 and 4173) are always allowed as well.
FRONTEND_URL=
# Optional extra browser origins, comma-separated (e.g. a staging frontend).
# Vercel serves each deployment under several domains (production, and git-branch
# aliases such as https://<project>-git-main-<team>.vercel.app); every domain the
# game is opened from must be listed here or in FRONTEND_URL, matching exactly.
CORS_ORIGINS=
