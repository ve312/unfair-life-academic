# Unfair Life inference API (FastAPI). These are read from the process environment
# (set them in the Render dashboard). Locally, copy this file to .env: main.py loads
# it at start-up, and variables already set in the environment take precedence.

# Render injects PORT; 8000 locally. The server always binds to 0.0.0.0.
PORT=8000

# Public origin(s) of the BFF, comma-separated, e.g. https://unfair-life-bff.onrender.com.
# Browser-only CORS rule; when unset, only the local BFF (localhost:3000) is allowed.
BFF_URL=

# Shared secret: POST /predict requires the header X-BFF-Token with this value.
# Must be identical to BFF_SECRET_TOKEN in the BFF. Required on Render (when unset
# there, every /predict request is rejected); locally it defaults to 'dev-secret-token',
# which the BFF rejects as soon as bff-api/.env sets its own token (403 -> 502 in the game).
BFF_SECRET_TOKEN=tobemodified

# Optional: folder holding best_model.joblib, imputer.joblib, encoder.joblib,
# feature_schema.json and traceability_report.json.
# Default: <repo>/ai-service/training-pipeline/artifacts
AI_ARTIFACTS_DIR=
