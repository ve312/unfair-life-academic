# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=1337
# Production: the public HTTPS address of this CMS (e.g. https://unfair-life-cms.onrender.com).
PUBLIC_URL=
# Trust the hosting proxy's X-Forwarded-* headers. Defaults to true when NODE_ENV=production;
# required behind Render's HTTPS proxy for admin logins to work.
# IS_PROXIED=true

# ---------------------------------------------------------------------------
# Secrets (generate unique random values for each environment)
# ---------------------------------------------------------------------------
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Shared secret the NestJS BFF sends in the Authorization header (exact match).
# Must equal BFF_SECRET_TOKEN in bff-api. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BFF_SECRET_TOKEN=tobemodified

# ---------------------------------------------------------------------------
# Database
# Development: SQLite in .tmp/data.db (DATABASE_FILENAME to change it).
# Production (NODE_ENV=production): PostgreSQL only; SQLite is refused because the
# hosting filesystem is ephemeral.
# ---------------------------------------------------------------------------
# Supabase: use the Session pooler connection string (IPv4), e.g.
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Optional: Supabase's CA certificate (PEM; "\n" for line breaks) to verify the server
# certificate. Without it the connection is encrypted but the certificate is not verified.
DATABASE_SSL_CA=
# Production pool defaults to min 0 / max 5 for free-tier connection limits.
# DATABASE_POOL_MIN=0
# DATABASE_POOL_MAX=5

# ---------------------------------------------------------------------------
# Media storage (production only: Cloudinary; development stores files in public/uploads)
# ---------------------------------------------------------------------------
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
